{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile synced from Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit admin allowlist document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Character": {
      "title": "Character",
      "description": "Character profile displayed in Cá Ngộ Độc archive.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "avatar": {
          "type": "string",
          "maxLength": 300000
        },
        "hashtags": {
          "type": "array",
          "description": "Bounded list of character hashtags (max 15)."
        },
        "slogan": {
          "type": "string",
          "maxLength": 300
        },
        "lore": {
          "type": "string",
          "maxLength": 20000
        },
        "links": {
          "type": "array",
          "description": "Bounded list of character reference links (max 10)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "avatar", "hashtags", "slogan", "lore", "links", "createdAt", "updatedAt"]
    },
    "CharacterLike": {
      "title": "CharacterLike",
      "description": "Heart/like record keyed by the authenticated user UID.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "createdAt"]
    },
    "CharacterComment": {
      "title": "CharacterComment",
      "description": "Public comment posted by a signed-in user on a character.",
      "type": "object",
      "properties": {
        "characterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["characterId", "userId", "userName", "content", "createdAt"]
    },
    "MusicTrack": {
      "title": "MusicTrack",
      "description": "Background music track entry managed by admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artist": {
          "type": "string",
          "maxLength": 120
        },
        "sourceType": {
          "type": "string",
          "enum": ["preset", "url"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        },
        "durationLabel": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "artist", "sourceType", "source", "durationLabel", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile PII isolated to owner and admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin UID allowlist."
    },
    "/characters/{characterId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Public character profiles managed by admins."
    },
    "/characters/{characterId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/CharacterLike" },
      "description": "Per-user heart/like documents for a character."
    },
    "/characters/{characterId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CharacterComment" },
      "description": "Public comments on a character."
    },
    "/tracks/{trackId}": {
      "schema": { "$ref": "#/entities/MusicTrack" },
      "description": "Background music tracks managed by admins."
    }
  }
}
